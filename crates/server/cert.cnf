[req]
prompt = no
default_md = sha256
distinguished_name = subject
x509_extensions = v3_server

[subject]
C = US
ST = Maryland
O = Raid Race
CN = localhost
emailAddress = devin@justdeeevin.dev

[v3_server]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = localhost
IP.1 = 127.0.0.1
IP.2 = ::1
